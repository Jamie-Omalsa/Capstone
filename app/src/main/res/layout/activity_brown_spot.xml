<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".diseases.BrownSpot">

    <!-- Back Button -->
    <ImageView
        android:layout_width="50dp"
        android:layout_height="80dp"
        android:src="@drawable/baseline_arrow_circle_left_24"
        android:id="@+id/bckBtn"
        android:elevation="10dp"
        android:padding="5dp"
        />

    <!-- Title Bar -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="Brown Spot"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:fontFamily="sans-serif-medium"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:background="#FF266839"
        android:id="@+id/titleBar"/>

    <!-- ScrollView for Disease Information -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/titleBar">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:src="@drawable/baseline_info_24"
                android:scaleType="centerCrop"
                android:id="@+id/imageV"
                android:layout_margin="10dp"/>

            <!-- Name of Disease -->
            <TextView
                android:id="@+id/diseaseName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name of Disease: Brown Spot"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_below="@id/imageV"
                android:fontFamily="sans-serif"
                android:textColor="@android:color/black"
                android:layout_marginBottom="8dp"/>

            <!-- Type of Disease -->
            <TextView
                android:id="@+id/diseaseType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Type of Disease: Fungal"
                android:textSize="16sp"
                android:fontFamily="sans-serif"
                android:textColor="@android:color/black"
                android:layout_below="@id/diseaseName"
                android:layout_marginBottom="8dp"/>

            <!-- Description -->
            <TextView
                android:id="@+id/diseaseDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Description: Brown spot is a fungal disease that infects the coleoptile, leaves, leaf sheath, panicle branches, glumes, and spikelets. Its most observable damage is the numerous big spots on the leaves which can kill the whole leaf. When infection occurs in the seed, unfilled grains or spotted or discolored seeds are formed. The disease can develop in areas with high relative humidity (86−100%) and temperature between 16 and 36°C. It is common in unflooded and nutrient-deficient soil, or in soils that accumulate toxic substances. For infection to occur, the leaves must be wet for 8−24 hours. The fungus can survive in the seed for more than four years and can spread from plant to plant through air. Major sources of brown spot in the field include: • infected seed, which give rise to infected seedlings • volunteer rice • infected rice debris • weeds Note: Brown spot can occur at all crop stages, but the infection is most critical during maximum tillering up to the ripening stages of the crop."
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:textColor="@android:color/black"
                android:layout_below="@id/diseaseType"
                android:layout_marginBottom="16dp"
                android:justificationMode="inter_word"/>

            <!-- Recommendations -->
            <TextView
                android:id="@+id/diseaseRecommendations"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recommendations:\n• Improving soil fertility is the first step in managing brown spot. To do this:\n• Monitor soil nutrients regularly\n• Apply required fertilizers\n• For soils that are low in silicon, apply calcium silicate slag before planting\n• Use resistant varieties. Contact your local agriculture office for up-to-date lists of varieties available.\n• Use fungicides (e.g., iprodione, propiconazole, azoxystrobin, trifloxystrobin, and carbendazim) as seed treatments.\n• Treat seeds with hot water (53−54°C) for 10−12 minutes before planting, to control primary infection at the seedling stage. To increase effectiveness of treatment, pre-soak seeds in cold water for eight hours."
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:justificationMode="inter_word"
                android:textColor="@android:color/black"
                android:layout_below="@id/diseaseDescription"
                android:layout_marginBottom="16dp"/>

            <android.widget.Button
                android:layout_width="285dp"
                android:layout_height="50dp"
                android:text="Save Image to Gallery"
                android:textColor="@android:color/white"
                android:fontFamily="sans-serif-medium"
                android:textSize="16sp"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_bg"
                android:layout_below="@+id/diseaseRecommendations"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="30dp"
                android:id="@+id/saveBtn"/>

        </RelativeLayout>
    </ScrollView>

</RelativeLayout>
