    <ImageView
        android:id="@+id/mPhoto"
        android:layout_width="300dp"
        android:layout_height="220dp"
        android:contentDescription="Capture Image Here"
        app:srcCompat="@drawable/logo"
        android:layout_marginBottom="8dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="50dp"/>

    <TextView
        android:id="@+id/txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/mPhoto"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/poppins"
        android:text="Palay Leaf Disease Detector"
        android:textColor="@android:color/white"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/txt5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/txt"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/poppins"
        android:text="App by average studs"
        android:textColor="@android:color/white"
        android:textSize="14sp" />


    <android.widget.Button
        android:text="DETECT"
        android:fontFamily="@font/bai_jamjuree"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:elevation="20dp"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:id="@+id/mDetectButton"
        android:background="@drawable/btn_bg"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/txt5"
        android:layout_marginTop="130dp"
        android:layout_marginBottom="8dp"/>



    <TextView
        android:hint="Image Analysis"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/mDetectButton"
        android:id="@+id/mResult"
        android:textStyle="bold"
        android:layout_marginTop="15dp"
        android:fontFamily="@font/bai_jamjuree"
        android:textColor="@android:color/black"
        android:textColorHint="@android:color/darker_gray"
        android:textSize="18sp"
        android:textAlignment="center"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/mDetectButton"
        android:id="@+id/loctest"
        android:textStyle="bold"
        android:layout_marginTop="15dp"
        android:fontFamily="sans-serif"
        android:textColor="@android:color/transparent"
        android:textColorHint="@android:color/transparent"
        android:textSize="20sp"
        android:textAlignment="center"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:id="@+id/mResultTextView"
        android:textStyle="italic"
        android:fontFamily="sans-serif"
        android:textColor="@android:color/black"
        android:textColorHint="@android:color/black"
        android:textSize="16sp"
        android:layout_below="@id/mDetectButton"
        android:layout_marginTop="50dp"
        android:textAlignment="center"/>

    <ImageView
        android:layout_width="40dp"
        android:layout_height="80dp"
        android:src="@drawable/baseline_info_24"
        android:layout_alignParentEnd="true"
        android:layout_margin="10dp"
        android:id="@+id/infoBtn"/>

