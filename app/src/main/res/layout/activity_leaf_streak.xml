<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".diseases.LeafStreak">

    <!-- Back Button -->
    <ImageView
        android:layout_width="50dp"
        android:layout_height="80dp"
        android:src="@drawable/baseline_arrow_circle_left_24"
        android:id="@+id/bckBtn"
        android:elevation="10dp"
        android:padding="5dp"
        />

    <!-- Title Bar -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="Leaf Streak"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:fontFamily="sans-serif-medium"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:background="#FF266839"
        android:id="@+id/titleBar"/>

    <!-- ScrollView for Disease Information -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/titleBar">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:src="@drawable/baseline_info_24"
                android:scaleType="centerCrop"
                android:id="@+id/imageV"
                android:layout_margin="10dp"/>

            <!-- Name of Disease -->
            <TextView
                android:id="@+id/diseaseName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name of Disease: Leaf Streak"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_below="@id/imageV"
                android:fontFamily="sans-serif"
                android:textColor="@android:color/black"
                android:layout_marginBottom="8dp"/>

            <!-- Type of Disease -->
            <TextView
                android:id="@+id/diseaseType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Type of Disease: Bacterial"
                android:textSize="16sp"
                android:fontFamily="sans-serif"
                android:textColor="@android:color/black"
                android:layout_below="@id/diseaseName"
                android:layout_marginBottom="8dp"/>

            <!-- Description -->
            <TextView
                android:id="@+id/diseaseDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Description: Leaf streak, caused by the bacterium Xanthomonas oryzae pv. oryzicola, appears as water-soaked streaks on rice leaves. These streaks may be yellow to brown and can extend along the leaf veins. In severe cases, the streaks coalesce, leading to significant leaf damage and yellowing. The disease is spread through rain, wind, and by infected seeds, and is more prevalent in warm, humid environments."
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:textColor="@android:color/black"
                android:layout_below="@id/diseaseType"
                android:layout_marginBottom="16dp"
                android:justificationMode="inter_word"/>

            <!-- Recommendations -->
            <TextView
                android:id="@+id/diseaseRecommendations"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recommendations: Use disease-free seeds, ensure proper field drainage, and avoid excess nitrogen fertilizer application. If severe, consider resistant rice varieties."
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:justificationMode="inter_word"
                android:textColor="@android:color/black"
                android:layout_below="@id/diseaseDescription"
                android:layout_marginBottom="16dp"/>

            <android.widget.Button
                android:layout_width="285dp"
                android:layout_height="50dp"
                android:text="Save Image to Gallery"
                android:textColor="@android:color/white"
                android:fontFamily="sans-serif-medium"
                android:textSize="16sp"
                android:layout_centerHorizontal="true"
                android:background="@drawable/btn_bg"
                android:layout_below="@+id/diseaseRecommendations"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="30dp"
                android:id="@+id/saveBtn"/>

        </RelativeLayout>
    </ScrollView>

</RelativeLayout>
